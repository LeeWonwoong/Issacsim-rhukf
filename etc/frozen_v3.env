# ══════════════════════════════════════════════════════════════════════
#  FROZEN-ENV v3  (동결 2026-09-06)
#  ─────────────────────────────────────────────────────────────────────
#  왜 v3 인가: 9월 캠페인(v2)이 8월 말 robust_chain/night_ablation 의
#  **난이도 노브를 승계하지 못했다**. 스크립트마다 export 를 손으로 적다가
#  ATK_ON·SPEED_MOD·COM_BIAS·EP_MAX_STEPS 네 줄이 누락됐고,
#  swrl_config 기본값(ON 40~80 · 300스텝)으로 조용히 되돌아갔다.
#  → Isaac 40런 + surrogate 400여 런이 의도보다 쉬운 환경에서 돌았다.
#
#  v3 = 8월의 난이도 노브  +  v2 의 더 센 바람/속도.
#  ★ 앞으로 모든 실행 스크립트는 이 파일을 source 한다. export 를 손으로 적지 않는다.
# ══════════════════════════════════════════════════════════════════════

# ── 공격 시간구조: 온셋킥 중심 (POMDP 의 핵심) ────────────────────────
#   ON 10~20 스텝 = 1~2초. 적분 여유가 짧아 온셋 판단이 곧 성패.
#   (v2 의 40~80 은 4~8초라 늦게 잡아도 나머지 구간에서 만회됐다 —
#    δ 상한을 0.7→0.2 로 낮춰도 F1 이 안 떨어진 원인)
export ATK_ON_LO=10  ATK_ON_HI=20
export ATK_OFF_LO=25 ATK_OFF_HI=40

# ── 자연 aliasing 원천: 가감속 ────────────────────────────────────────
#   등속 비행은 토크≈0 이라 gyro 가 깨끗하다. 속도 변조가 가감속을 만들어
#   기동 aliasing(평시 gyro 스파이크)을 생성한다. 이게 POMDP 노이즈의 주 원천.
export SPEED_MOD_AMP=0.5 SPEED_MOD_FREQ=0.5

# ── 모델오차 랜덤화 ──────────────────────────────────────────────────
export COM_BIAS_STD=0.05

# ── 에피소드 길이 (08-23 확정본 값) ──────────────────────────────────
export EP_MAX_STEPS=400

# ── v2 에서 승계: 회전바람 강화 + 고속 궤적 ──────────────────────────
export WIND_MOMENT_ARM=0.07
export SPEED_SCALE=1.25
export MPC_ACC_HOR=4.0
export SENSOR_NOISE_SCALE=1.0

# ★2026-09-10 가속도 피드포워드 (TrajectorySetpoint.acceleration). 09-06 동결 때 누락된 회귀 — circle 반경편향 +0.32m·waypoint 코너 오버슛의 원인. 실기 f5_pattern 도 동일 송신.
export ACCEL_FF=1
